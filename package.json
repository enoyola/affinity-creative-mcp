    "check": "npm run build && npm test",
    "start": "node dist/index.js",
    "prepack": "npm run check"
  },
  "engines": {
    "node": ">=22.7.5"
  },
  "os": [
    "darwin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
