{
  "name": "affinity-creative-mcp",
  "version": "0.3.0",
  "description": "A safe MCP facade for automating Affinity Photo, Designer, and Publisher workflows.",
  "license": "MIT",
  "author": "enoyola",
  "homepage": "https://github.com/enoyola/affinity-creative-mcp#readme",
  "bugs": {
    "url": "https://github.com/enoyola/affinity-creative-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enoyola/affinity-creative-mcp.git"
  },
  "keywords": [
    "affinity",
    "affinity-designer",
    "affinity-photo",
    "affinity-publisher",
    "automation",
    "codex",
    "design-automation",
    "mcp",
    "model-context-protocol"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "affinity-creative-mcp": "dist/index.js"
  },
  "files": [
    "dist/",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
